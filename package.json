{
  "private": true,
  "type": "module",
  "name": "template-storybook-vue",
  "version": "0.5.0",
  "browserslist": [
    "baseline 2025"
  ],
  "prettier": "@epreston/prettier-config",
  "packageManager": "npm@11.8.0",
  "engines": {
    "node": "^22.22.0 || >=24.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --emptyOutDir",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,vue}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@epreston/eslint-config": "^2.4.2",
    "@epreston/prettier-config": "^2.1.1",
    "@epreston/tsconfig": "^1.2.2",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/vue3": "^10.5.7",
    "@storybook/vue3-vite": "^10.5.7",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.8.0",
    "eslint-plugin-storybook": "^10.5.7",
    "eslint-plugin-vue": "^10.10.0",
    "prettier": "^3.9.6",
    "storybook": "^10.5.7",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "pinia": "^4.0.2",
    "vue": "^3.5.41"
  },
  "allowScripts": {
    "esbuild": true
  }
}
