{
  "private": true,
  "type": "module",
  "name": "template-storybook-vue",
  "version": "0.5.0",
  "browserslist": [
    "baseline 2025"
  ],
  "prettier": "@epreston/prettier-config",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --emptyOutDir",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,vue}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@epreston/eslint-config": "^3.0.0",
    "@epreston/prettier-config": "^2.1.2",
    "@epreston/tsconfig": "^1.2.3",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-links": "^10.6.5",
    "@storybook/vue3": "^10.6.5",
    "@storybook/vue3-vite": "^10.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.13.0",
    "eslint-plugin-storybook": "^10.6.5",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "storybook": "^10.6.5",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.44"
  },
  "allowScripts": {
    "esbuild": true
  }
}
